# ComicCraft Environment Configuration
# Copy this file to .env and fill in your values

# ─── AI Configuration ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_IMAGE_MODEL=gemini-1.5-flash

# ─── Image Generation ───────────────────────────────────────────────────
# Options: huggingface | gemini | mock
IMAGE_PROVIDER=gemini
HF_API_KEY=your_huggingface_api_key_here
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ─── Database ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./comiccraft.db

# ─── Application Security ───────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── App Settings ───────────────────────────────────────────────────────
APP_NAME=ComicCraft
DEBUG=true

# ─── Demo / Development Mode ────────────────────────────────────────────
# Set to true to use deterministic sample data without calling any AI APIs
DEMO_MODE=false
